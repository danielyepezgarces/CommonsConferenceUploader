<?php

/**
 * LocalSettings.php - MediaWiki-style configuration override
 * 
 * This file allows you to override application settings without modifying
 * .env or config files. Similar to MediaWiki's LocalSettings.php.
 * 
 * Copy this file to LocalSettings.php and customize as needed.
 * LocalSettings.php is loaded after .env but before the application boots,
 * allowing you to override any configuration value.
 * 
 * Usage:
 * 1. Copy LocalSettings.php.example to LocalSettings.php
 * 2. Uncomment and modify the settings you want to override
 * 3. LocalSettings.php is git-ignored for security
 */

// ============================================================================
// Application Settings
// ============================================================================

// Override application name
// $GLOBALS['wgCommonsUploader']['app_name'] = 'My Custom Uploader';

// Override application URL
// $GLOBALS['wgCommonsUploader']['app_url'] = 'https://myuploader.example.com';

