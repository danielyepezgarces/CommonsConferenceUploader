# Application Configuration
APP_NAME=CommonsEventUploader
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=commons_uploader
